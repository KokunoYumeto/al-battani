     "tex": "\\CenterLine{$\\dfrac{R^2 - R\\,\\text{cos distantiae}}{2} = \\sin^2\\left(\\dfrac{L - L'}{2}\\right) \\dfrac{\\cos\\text{\\textgreek{β}} \\cos\\text{\\textgreek{β}}'}{R^2} + \\dfrac{R^2 - R \\cos(\\text{\\textgreek{β}} - \\text{\\textgreek{β}}')}{2} =$}",
