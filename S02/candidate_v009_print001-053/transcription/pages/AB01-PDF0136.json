      "lines": [
        {
          "id": "AB01-PDF0136-body-L001",
          "source_line_no": 1,
          "tex": "\\Indent Dicit [auctor]: Nunc aliter haec explicabimus. Circa centrum E et diametrum AC, sit",
          "semantic_anchor": "AB01-PDF0136-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L002",
          "source_line_no": 2,
          "tex": "circulus eclipticae ABC; circa centrum H, excentricus FMG; et diametrus AC per ambo",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L003",
          "source_line_no": 3,
          "tex": "centra transeat. Erit F punctum apogei in circulo parecliptico, G perigei. Initio locum Solis",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L004",
          "source_line_no": 4,
          "tex": "in excentrico in M esse ponamus, et arcum FM excentrici, quem Sol iam percurrit, $30^\\circ$ com-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L005",
          "source_line_no": 5,
          "tex": "plecti; angulus FHM erit quoque $30^\\circ$. Lineam EH, ambo centra coniungentem, iam vidimus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L006",
          "source_line_no": 6,
          "tex": "$2^p4'\\,\\qfrac{3}{4}$ esse. Semidiametrum HM excentrici et lineam EM ducamus, HM usque ad punctum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L007",
          "source_line_no": 7,
          "tex": "L quo cum perpendiculari LE convenit protrahentes. Triangulum HLE rectangulum est; eius",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L008",
          "source_line_no": 8,
          "tex": "angulus LHE aequat angulum datum FHM; arcus super EL, ex circulo triangulum HLE",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L009",
          "source_line_no": 9,
          "tex": "circumdanti, si circumferentia $360^\\circ$ continet, $30^\\circ$ complectetur, eiusque sinus $30^p$ quoque ex",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L010",
          "source_line_no": 10,
          "tex": "partibus quarum linea HE inter ambo centra 60 habet. Remanebit linea LH, quadrantem per-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L011",
          "source_line_no": 11,
          "tex": "ficiens, $51^p57'41''$, nam arcus complementaris LH $60^\\circ$ continet. Sed ea ratione qua linea HE",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L012",
          "source_line_no": 12,
          "tex": "inter ambo centra $2^p4'\\,\\qfrac{3}{4}$ complectitur, linea EL $1^p2'22''\\,\\qfrac{1}{2}$ (1) erit, et linea LH, quadran-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L013",
          "source_line_no": 13,
          "tex": "tem perficiens, $1^p48'2''$; itaque linea tota LM $61^p48'2''$. Triangulum MLE rectangulum est;",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L014",
          "source_line_no": 14,
          "tex": "eius hypotenusam EM $61^p48'35''$ esse vidimus. Sed ratione qua lineae EM $60^p$ tribuuntur,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L015",
          "source_line_no": 15,
          "tex": "EL est $1^p33'$ (2), et arcus super eam $0^\\circ57'49''$, cum circulus triangulum HLE circumdans",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L016",
          "source_line_no": 16,
          "tex": "$360^\\circ$ sit. Arcus igitur AB eclipticae $29^\\circ2'11''$ fere remanebit.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L017",
          "source_line_no": 17,
          "tex": "\\Indent Item Solem in puncto D excentrici esse ponamus, arcumque FD (3) $150^\\circ$ complecti; reli-",
          "semantic_anchor": "AB01-PDF0136-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L018",
          "source_line_no": 18,
          "tex": "quus arcus DG, inter locum Solis et perigeum, $30^\\circ$ erit. Lineas EK et HD, quarum utraque",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L019",
          "source_line_no": 19,
          "tex": "est sui circuli semidiametrus, ducamus; item perpendicularem ES. Triangulum HSE rectan-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L020",
          "source_line_no": 20,
          "tex": "gulum est; latus EH, ambo centra coniungens, latus ES, angulus DHG (4) nota sunt; erunt",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L021",
          "source_line_no": 21,
          "tex": "ergo nota latus HS et angulus HES (5). Cognoscuntur igitur quoque linea DG et hypotenusa",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L022",
          "source_line_no": 22,
          "tex": "ED trianguli rectanguli ESD. Cum vero datus arcus DG et datus angulus GHD $30^\\circ$ sint ut",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L023",
          "source_line_no": 23,
          "tex": "diximus, eorumque sinus $30^p$ pariter, arcus quoque ES circuli triangulum rectangulum ESH",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L024",
          "source_line_no": 24,
          "tex": "circumdantis complectetur $30^\\circ$ ex partibus quarum totus ille circulus $360^\\circ$ habet, et eius sinus,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L025",
          "source_line_no": 25,
          "tex": "nempe cathetus ES, $30^p$ quoque e partibus quarum linea EH, semidiametrus huius circuli, $60^p$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L026",
          "source_line_no": 26,
          "tex": "complectitur. Sed ratione qua lineae EH $2^p4'\\,\\qfrac{3}{4}$ tribuuntur, cathetus ES erit $1^p2'22''\\,\\qfrac{1}{2}$ (6);",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L027",
          "source_line_no": 27,
          "tex": "qua re latus SH $1^p48'2''$ remanebit.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L028",
          "source_line_no": 28,
          "tex": "Semidiametrus HD excentrici $60^p$ conti-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L029",
          "source_line_no": 29,
          "tex": "net, de quibus si SH dematur, remanent",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L030",
          "source_line_no": 30,
          "tex": "lineae SD $58^p11'58''$; igitur hypote-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L031",
          "source_line_no": 31,
          "tex": "nusa ED trianguli rectanguli ESD erit",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L032",
          "source_line_no": 32,
          "tex": "circiter $58^p12'32''$ (7). Sed ex partibus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L033",
          "source_line_no": 33,
          "tex": "quarum linea ED 60 habet, cathetus ES",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L034",
          "source_line_no": 34,
          "tex": "$1^p4'17''$ complectetur, et arcus super",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L035",
          "source_line_no": 35,
          "tex": "eam, qui est quantitas anomaliae, $1^\\circ1'$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L036",
          "source_line_no": 36,
          "tex": "$24''$ (8): arcus igitur KC eclipticae, $31^\\circ$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L037",
          "source_line_no": 37,
          "tex": "$1'24''$ (9) circiter erit. Haec de anomalia",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L038",
          "source_line_no": 38,
          "tex": "sufficiunt, quam explicare volebamus.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L039",
          "source_line_no": 39,
          "tex": "\\Indent Dicit [auctor]: Hunc motum ita ad",
          "semantic_anchor": "AB01-PDF0136-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0136-body-L040",
          "source_line_no": 40,
          "tex": "singulos gradus in tabulis a puncto apogei posuimus; similiter reperiuntur aequatio simplex",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
    },
