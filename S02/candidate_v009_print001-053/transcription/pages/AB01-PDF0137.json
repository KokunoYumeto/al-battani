  "sections": [
    {
      "role": "body",
      "authorship": "NALLINO_TRANSLATION",
      "lines": [
        {
          "id": "AB01-PDF0137-body-L001",
          "source_line_no": 0,
          "tex": "Lunae et aequatio media quinque planetarum, quae est semidiametrus eorum epicycli, cum",
          "semantic_anchor": "AB01-PDF0137-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L002",
          "source_line_no": 1,
          "tex": "eius sinus sumatur et eo modo dividatur.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L003",
          "source_line_no": 2,
          "tex": "\\Indent Si id calculo reperire vis, gradus epicycli quos ab apogeo Sol, vel Luna, vel planeta",
          "semantic_anchor": "AB01-PDF0137-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L004",
          "source_line_no": 3,
          "tex": "percurrerit, scilicet anomaliam, observa; si gradus minus quam $180^\\circ$ sunt, iis utere, sed si",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L005",
          "source_line_no": 4,
          "tex": "$180^\\circ$ superant, eos de $360^\\circ$ deme et residuum adhibe. Graduum alterutra via repertorum, si",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L006",
          "source_line_no": 5,
          "tex": "minus quam $90^\\circ$ sunt, sinum atque cosinum multiplica in semidiametrum epicycli sideris qui",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L007",
          "source_line_no": 6,
          "tex": "est totius aequationis sinus; ambo producta per semidiametrum divide, et quod ex divisione",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L008",
          "source_line_no": 7,
          "tex": "cosinus provenerit adde $60^p$ scilicet semidiametro. Quadratum huius summae adde quadrato",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L009",
          "source_line_no": 8,
          "tex": "eius quod e divisione sinus exierit; huius summae radicem inveni. Deinde quod e divisione",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L010",
          "source_line_no": 9,
          "tex": "sinus provenerat, in semidiametrum multiplica, et productum per inventam radicem divide. ---",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L011",
          "source_line_no": 10,
          "tex": "Si contra gradus adhibendi superant $90^\\circ$, de iis $90^\\circ$ deme; sinum et cosinum residui in semi-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L012",
          "source_line_no": 11,
          "tex": "diametrum epicycli multiplica et per semidiametrum divide; quod e sinu provenerit de $60^p$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L013",
          "source_line_no": 12,
          "tex": "deme; quadratum residui adde quadrato eius quod e cosinu exierit, et huius summae radi-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L014",
          "source_line_no": 13,
          "tex": "cem inveni. Postea quod e divisione cosinus provenerat in semidiametrum multiplica, et pro-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L015",
          "source_line_no": 14,
          "tex": "ductum per radicem inventam divide. --- Quod ex alterutra operatione tibi provenerit, in",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L016",
          "source_line_no": 15,
          "tex": "arcum converte; arcus erit portio graduum ad anomaliam qua usus es pertinens, scilicet ae-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L017",
          "source_line_no": 16,
          "tex": "quatio stellae ({\\itshape f}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L018",
          "source_line_no": 17,
          "tex": "\\Indent Semidiametrus epicycli Solis est $2^p4'45''$ (1); semidiametrus epicycli Lunae $5^p15'$ (2);",
          "semantic_anchor": "AB01-PDF0137-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L019",
          "source_line_no": 18,
          "tex": "Saturni $6^p29'50''$ (3); Iovis $11^p30'0''$ (4); Martis $39^p27'22''$ (5); Veneris $43^p9'0''$ (6); Mer-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L020",
          "source_line_no": 19,
          "tex": "curii $22^p30'30''$ (7). Hoc ex observationibus patuit et cum calculis congruit; idque, volente",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L021",
          "source_line_no": 20,
          "tex": "Deo, est sinus aequationis mediae ({\\itshape g}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L022",
          "source_line_no": 23,
          "tex": "\\CenterLine{CAPUT XXIX.}",
          "semantic_anchor": "AB01-PDF0137-H01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L023",
          "source_line_no": 25,
          "tex": "\\CenterLine{De inaequalitate nychthemerōn et de aliorum in alia conversione.}",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L024",
          "source_line_no": 27,
          "tex": "\\Indent Dicit [auctor]: Plurimi homines et vulgus nychthemera existimant aequalia esse, et eo-",
          "semantic_anchor": "AB01-PDF0137-P04",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L025",
          "source_line_no": 28,
          "tex": "rum quodque 24 horas amplecti; sed hoc haud verum est, nam nychthemerum medium est",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L026",
          "source_line_no": 29,
          "tex": "ortus omnium 360 temporum aequatoris ab horizonte vel a circulo meridiano, eo addito quod",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L027",
          "source_line_no": 30,
          "tex": "ex aequatoris temporibus ascendit cum 59 minutis quae Sol, motu suo medio, in nychthemero",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L028",
          "source_line_no": 31,
          "tex": "percurrit. Nychthemerum autem inaequale est ortus 360 temporum aequatoris, addito motu",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L029",
          "source_line_no": 32,
          "tex": "inaequali Solis in nychthemero, qui necessarie minor aut maior est quam $59'$.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L030",
          "source_line_no": 33,
          "tex": "\\Indent Quoniam omni loco initium a circulo horizontis variat prout in illo variant ascensiones",
          "semantic_anchor": "AB01-PDF0137-P05",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L031",
          "source_line_no": 34,
          "tex": "signorum, initium autem ab hora meridiana immobile est neque mutatur, ob aequalitatem",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L032",
          "source_line_no": 35,
          "tex": "ascensionum signorum in circulo meridiano quolibet loco, in calculo stellarum earumque lo-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L033",
          "source_line_no": 36,
          "tex": "corum initium diei non ponitur ab ortu vel occasu Solis, sed a tempore meridiei aut mediae",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L034",
          "source_line_no": 37,
          "tex": "noctis (8) ({\\itshape a}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L035",
          "source_line_no": 38,
          "tex": "\\Indent Item quoniam omnes motus stellarum in tabulis nonnisi ad aequales dies supputantur,",
          "semantic_anchor": "AB01-PDF0137-P06",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L036",
          "source_line_no": 39,
          "tex": "differentia inter nychthemera inaequalia et nychthemera media negligitur. In motu Solis et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0137-body-L037",
          "source_line_no": 40,
          "tex": "reliquarum stellarum differentia tanta non est ut errorem sensibilem gignat; sed error mani-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
    },
