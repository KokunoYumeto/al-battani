          "id": "AB01-PDF0142-body-L001",
          "source_line_no": 1,
          "tex": "\\Indent Lineam ME (1) usque ad L producamus, et L cum F coniungamus (2); in triangulo MLF",
          "semantic_anchor": "AB01-PDF0142-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L002",
          "source_line_no": 2,
          "tex": "latera proportionalia (3), anguli noti sunt. Arcum AM, ut Ptolemaeus statuit, $120^\\circ$ ponamus (4),",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L003",
          "source_line_no": 3,
          "tex": "quae est dupla elongatio Lunae a Sole. Quoniam rationem sinuum ad semidiametrum (5) re-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L004",
          "source_line_no": 4,
          "tex": "ferimus, angulus EFL (6) $30^\\circ$, eiusque complementum FEL $60^\\circ$ continebit, iuxta rationem qua",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L005",
          "source_line_no": 5,
          "tex": "circulus triangulum FEL circumdans $360^\\circ$ complectitur. Sinus anguli EFL (7) $30^p$ quoque erit,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L006",
          "source_line_no": 6,
          "tex": "et sinus anguli FEL circiter $51^p58'$ (8) ex partibus quarum linea EF 60 continet; sed si huic",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L007",
          "source_line_no": 7,
          "tex": "lineae $10^p19'$ tantum (9) tribuantur, linea EL $5^p10'$, linea FL $9^p16'$ (10) circiter fiet. Cum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L008",
          "source_line_no": 8,
          "tex": "in figura linea EKN epicyclum tetigerit, et locus Lunae in epicyclo fuerit punctum K, erit",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L009",
          "source_line_no": 9,
          "tex": "id maximum quod attingit summa primae inaequalitatis et secundae. Cum autem semidiame-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L010",
          "source_line_no": 10,
          "tex": "trus MK epicycli et semidiametrus FM excentrici notae sint, ex ratione FM et FL ratio li-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L011",
          "source_line_no": 11,
          "tex": "neae ML deprehendetur, eritque tota ML $48^p53'$; de qua, linea EL scilicet $5^p10'$ demptis,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L012",
          "source_line_no": 12,
          "tex": "remanet linea EM a centro [Terrae sive zodiaci] progrediens $43^p43'$. Semidiametrum MK",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L013",
          "source_line_no": 13,
          "tex": "epicycli vidimus $5^p15'$ esse: sed si lineae EM a centro [Terrae vel zodiaci] progredienti $60^p$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L014",
          "source_line_no": 14,
          "tex": "tribuantur, semidiametrus MK epicycli declivis [ab apogeo excentrici] $7^p12'$ circiter fiet,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L015",
          "source_line_no": 15,
          "tex": "et arcus MK super eam insistens $6^\\circ54'$ (11) fere continebit. De quo, si tota simplex inaequali-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L016",
          "source_line_no": 16,
          "tex": "tas, idest $5^\\circ1'$, dematur, altera inaequalitas ei adiecta remanebit $1^\\circ53'$; et si illi $2^\\circ\\qfrac{2}{3}$ (12) fiant",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L017",
          "source_line_no": 17,
          "tex": "$60'$, hi $1^\\circ53'$ in partes sexagesimas $0^\\circ42'38''$ (13) convertentur, quae sub numero 120 in",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L018",
          "source_line_no": 18,
          "tex": "quarta (14) columna reperiuntur. {\\itshape Hoc secundum rationem minutorum ad gradum, quae}",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L019",
          "source_line_no": 19,
          "tex": "{\\itshape est ratio $0^\\circ42'38''$ ad $60'$. Si haec $0^\\circ42'38''$ usque ad $60'$ crescunt, ea $1^\\circ53'$ fiunt}",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L020",
          "source_line_no": 20,
          "tex": "{\\itshape $2^\\circ39'$, quae in quinta} (15) {\\itshape columna sub numero 120} (16) {\\itshape leguntur} ({\\itshape c}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0142-body-L021",
          "source_line_no": 21,
