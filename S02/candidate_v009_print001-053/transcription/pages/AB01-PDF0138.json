          "id": "AB01-PDF0138-notes_left-L001",
          "source_line_no": null,
          "tex": "\\Indent (1) Male Plato $3^\\circ\\qfrac{1}{5}+\\qfrac{1}{10}$, quod $3^\\circ18'$ effice-",
          "semantic_anchor": "AB01-PDF0138-N01",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_left-L002",
          "source_line_no": null,
          "tex": "ret. --- In {\\itshape Almag.} III, 8 (ed. Halma t. I, 209) est $3^\\circ\\qfrac{2}{3}$;",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_left-L003",
          "source_line_no": null,
          "tex": "ibi enim excentricitas orbis solaris maior est quam",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_left-L004",
          "source_line_no": null,
          "tex": "apud al-Battānī.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_left-L005",
          "source_line_no": null,
          "tex": "\\Indent (2) {\\itshape Almag.} $4^\\circ\\qfrac{2}{3}$; differentia e diversa eclipti-",
          "semantic_anchor": "AB01-PDF0138-N02",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_left-L006",
          "source_line_no": null,
          "tex": "cae obliquitate provenit.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        }
      ]
    },
    {
      "role": "notes_right",
      "authorship": "NALLINO_APPARATUS",
      "lines": [
        {
          "id": "AB01-PDF0138-notes_right-L001",
          "source_line_no": null,
          "tex": "\\Indent (3) {\\itshape Almag.} $8^\\circ\\qfrac{1}{3}$ scilicet $\\qfrac{1}{2}+\\qfrac{1}{18}$ horae.",
          "semantic_anchor": "AB01-PDF0138-N03",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_right-L002",
          "source_line_no": null,
          "tex": "\\Indent (4) {\\itshape Almag.} $\\qfrac{1}{2}$.",
          "semantic_anchor": "AB01-PDF0138-N04",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_right-L003",
          "source_line_no": null,
          "tex": "\\Indent (5) {\\itshape Almag.} $\\qfrac{1}{2}$.",
          "semantic_anchor": "AB01-PDF0138-N05",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_right-L004",
          "source_line_no": null,
          "tex": "\\Indent (6) Plato 58. --- Cur id fecerit explicatur in",
          "semantic_anchor": "AB01-PDF0138-N06",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_right-L005",
          "source_line_no": null,
          "tex": "adnot. {\\itshape b} ad hoc caput.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0138-notes_right-L006",
