  "sections": [
    {
      "role": "body",
      "authorship": "NALLINO_TRANSLATION",
      "lines": [
        {
          "id": "AB01-PDF0138-body-L001",
          "source_line_no": 1,
          "tex": "festus est in Luna, ob eius festinum cursum, ita ut fere dimidiae horae sit; nam interdum",
          "semantic_anchor": "AB01-PDF0138-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L002",
          "source_line_no": 2,
          "tex": "Lunae motus eo temporis spatio 18 minuta complectitur, cuius duplum est differentia inter",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L003",
          "source_line_no": 3,
          "tex": "maxima et minima nychthemera.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L004",
          "source_line_no": 4,
          "tex": "\\Indent Haec differentia e duobus elementis constat, quorum alterum est inaequalitas motus Solis,",
          "semantic_anchor": "AB01-PDF0138-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L005",
          "source_line_no": 5,
          "tex": "sive aequatio, alterum differentia transitus signorum per medium Caelum, quia non omnia illic",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L006",
          "source_line_no": 6,
          "tex": "eadem quantitate ascendunt. Quod maximi ex anomalia motus Solis provenit est fere $3^\\circ\\qfrac{1}{4}+$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L007",
          "source_line_no": 7,
          "tex": "$\\qfrac{1}{10}$ (1) [$=3^\\circ21'$], quod e culminatione signorum $4^\\circ\\qfrac{1}{4}+\\qfrac{1}{5}$ (2) [$=4^\\circ27'$] circiter; summa",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L008",
          "source_line_no": 8,
          "tex": "igitur est $7^\\circ48'$ (3), quae $\\qfrac{1}{2}+\\qfrac{1}{50}$ horae aequinoctialis [$=0^h\\,31^m\\,12^s$] circiter efficiunt. Locus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L009",
          "source_line_no": 9,
          "tex": "deminutionis fere a $\\qfrac{2}{3}$ (4) Aquarii ad initium circiter Scorpionis porrigitur; locus augmenti",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L010",
          "source_line_no": 10,
          "tex": "ab initio Scorpionis ad $\\qfrac{2}{3}$ (5) fere Aquarii. --- In tabulis huius nostri libri nos motus medios",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L011",
          "source_line_no": 11,
          "tex": "descripsimus, ponentes locum Solis, iuxta eius motum medium, in $18^\\circ19'$ [Aquarii], at secun-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L012",
          "source_line_no": 12,
          "tex": "dum veracem motum apparentem in $20^\\circ$ Aquarii. Et iuxta hoc nychthemerum reliqua nych-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L013",
          "source_line_no": 13,
          "tex": "themera anni in hoc libro supputa ({\\itshape b}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L014",
          "source_line_no": 14,
          "tex": "\\Indent Dicit [auctor]: Si vis dies inaequales convertere in dies medios, ad quos in tabulis sunt",
          "semantic_anchor": "AB01-PDF0138-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L015",
          "source_line_no": 15,
          "tex": "motus medii descripti, sume gradus inter medium locum Solis datum et locum alterum ad",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L016",
          "source_line_no": 16,
          "tex": "quem Sol motu medio pervenerit ({\\itshape c}); item, per tempora ascensionum rectarum signorum,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L017",
          "source_line_no": 17,
          "tex": "gradus inter primum locum verum et locum ad quem Sol motu vero pervenerit. Si numerus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L018",
          "source_line_no": 18,
          "tex": "horum temporum numerum graduum motus medii superat, quanta pars unius horae aequino-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L019",
          "source_line_no": 19,
          "tex": "ctialis differentia sit, vide, et eam partem diebus inaequalibus datis adde. Si contra numerus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L020",
          "source_line_no": 20,
          "tex": "temporum minor est, eam partem de iis diebus deme. Exibunt dies medii, in quos dies inaequa-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L021",
          "source_line_no": 21,
          "tex": "les dati convertendi erant, sive a meridie sive a media nocte calculus diei inchoatus est. ---",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L022",
          "source_line_no": 22,
          "tex": "Rem contrariam fac, si dies medios tabularum in dies inaequales convertere vis; idest partem",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L023",
          "source_line_no": 23,
          "tex": "illam diebus mediis adde vel de iis deme, prout numerus temporum minor vel maior fuerit.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L024",
          "source_line_no": 24,
          "tex": "Invenies dies inaequales quaesitos.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L025",
          "source_line_no": 25,
          "tex": "\\Indent Iuxta hoc principium, in hoc nostro libro constitutum, numerus temporum semper minor",
          "semantic_anchor": "AB01-PDF0138-P04",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L026",
          "source_line_no": 26,
          "tex": "erit a loco Solis dato usque ad terminum longi spatii temporis, in quo variatio apogei Solis,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L027",
          "source_line_no": 27,
          "tex": "quod in ecliptica invenimus, crescet; qua re mutabitur quod ex inaequalitate motus Solis pro-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L028",
          "source_line_no": 28,
          "tex": "venit. Et cum res ita sint ut diximus, loco medio Lunae in initio calculi 18 (6) minuta addidi-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L029",
          "source_line_no": 29,
          "tex": "mus; portionem autem variationis nychthemerōn, quae ad singulos gradus signorum pertinet,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L030",
          "source_line_no": 30,
          "tex": "in tabulis ascensionum rectarum (7) descripsimus in columna quae ascensiones singulorum gra-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L031",
          "source_line_no": 31,
          "tex": "duum sequitur. Si igitur quod vero gradui Solis respondet sumpserimus, et partem propor-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L032",
          "source_line_no": 32,
          "tex": "tionalem unius horae aequinoctialis de diebus inaequalibus detraxerimus, remanebunt dies",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L033",
          "source_line_no": 33,
          "tex": "medii, ad quos in tabulis motus reperiuntur; si vero eam diebus mediis addiderimus, exibunt",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0138-body-L034",
          "source_line_no": 34,
          "tex": "dies inaequales qui calculo deducuntur ({\\itshape d}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
    },
    {
      "role": "notes_left",
      "authorship": "NALLINO_APPARATUS",
      "lines": [
