      "lines": [
        {
          "id": "AB01-PDF0133-body-L001",
          "source_line_no": 1,
          "tex": "partem quam Sol medio suo itinere ab initio Arietis ad initium Librae percurrit, scilicet, ut",
          "semantic_anchor": "AB01-PDF0133-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L002",
          "source_line_no": 2,
          "tex": "supra vidimus, $183^\\circ56'12''$. Arcus KLRM, semicircumferentia excentrici, $180^\\circ$ continet; quis-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L003",
          "source_line_no": 3,
          "tex": "que igitur arcuum PK, YM est dimidia pars eorum $3^\\circ56'12''$, quibus Sol medio suo itinere",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L004",
          "source_line_no": 4,
          "tex": "$180^\\circ$ superat, idest $1^\\circ58'6''$. --- Manifestum etiam est arcum PKLR (1) excentrici id esse quod",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L005",
          "source_line_no": 5,
          "tex": "Sol, medio suo itinere, ab initio Arietis ad initium Cancri percurrit; igitur $92^\\circ14'10''$ erit;",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L006",
          "source_line_no": 6,
          "tex": "et quia arcus PKL, ob ea quae nuper diximus, $91^\\circ58'6''$ complectitur, arcus LR $0^\\circ16'4''$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L007",
          "source_line_no": 7,
          "tex": "continebit. Item manifestum est perpendicularem PQ sinum esse arcus PK, et perpendicula-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L008",
          "source_line_no": 8,
          "tex": "rem RG sinum arcus LR; igitur PQ fere $2^p3'39''$, et RG fere $0^p16'45''$ erit. Quoniam",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L009",
          "source_line_no": 9,
          "tex": "linea KM parallela est lineae AC, erit linea ES aequalis PQ; et similiter, quia LN parallela",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L010",
          "source_line_no": 10,
          "tex": "est lineae BD, erit FS aequalis RG. Est itaque etiam latus EF trianguli rectanguli ESF no-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L011",
          "source_line_no": 11,
          "tex": "tum; quadratum lateris ES est fere $4^p14'48''$, quadratum lateris FS fere $0^p4'41''$, summa",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L012",
          "source_line_no": 12,
          "tex": "igitur $4^p19'29''$ (2) efficit quadratum lateris EF, cuius radix $2^p4'\\,\\qfrac{3}{4}$ est quantitas lineae EF",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L013",
          "source_line_no": 13,
          "tex": "ambo centra coniungentis. Ea ratione autem, qua quadrans circuli triangulum rectangulum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L014",
          "source_line_no": 14,
          "tex": "ESF circumdantis $90^\\circ$ complectitur, et semidiametrus $60^p$, erit arcus EF circiter $1^\\circ59'$ (3); et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L015",
          "source_line_no": 15,
          "tex": "haec est maxima anomalia motus Solis per has observationes manifesta ({\\itshape b}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L016",
          "source_line_no": 16,
          "tex": "\\Indent Nunc in quantitatem arcus BH eclipticae inquiramus; qua cognita, etiam arcus HA reli-",
          "semantic_anchor": "AB01-PDF0133-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L017",
          "source_line_no": 17,
          "tex": "quus notus erit. Punctum T est locus apogei in circulo Solis excentrico; nam, si lineam EF,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L018",
          "source_line_no": 18,
          "tex": "ambo centra coniungentem, usque ad eclipticam producimus, ipsa circulum KLMN in T, et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L019",
          "source_line_no": 19,
          "tex": "circulum eclipticae in H secat. Necesse est ut rationem lineae EF ad semidiametrum EH co-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L020",
          "source_line_no": 20,
          "tex": "gnoscamus, nec non quantitatem arcus BH eclipticae. Iam vidimus lineam EF $2^p4'\\,\\qfrac{3}{4}$ com-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L021",
          "source_line_no": 21,
          "tex": "plecti ea ratione qua semidiametrus $60^p$ continet; eadem ratione igitur linea EH, quae, ut EB,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L022",
          "source_line_no": 22,
          "tex": "semidiametrus est, lineam EF 28 vicibus et $\\qfrac{5}{6}$ fere continebit. Quoniam linea FS, ut dixi-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L023",
          "source_line_no": 23,
          "tex": "mus, [$0^p16'45''$] est, si linea EF $60^p$ ponatur, erit iuxta hanc rationem linea FS circiter $8^p4'$;",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L024",
          "source_line_no": 24,
          "tex": "hoc enim invenitur si $28\\,\\qfrac{5}{6}$ vicibus [$0^p16'45''$]",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L025",
          "source_line_no": 25,
          "tex": "multiplicantur. --- Aut, si mavis, lineam FS in",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L026",
          "source_line_no": 26,
          "tex": "semidiametrum EH multiplica; invenies $16^p45'$,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L027",
          "source_line_no": 27,
          "tex": "quae, per lineam EF scilicet per $2^p4'\\,\\qfrac{3}{4}$ divisa,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L028",
          "source_line_no": 28,
          "tex": "dabunt $8^p4'$, quod est [sinus] anguli BEH; ar-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L029",
          "source_line_no": 29,
          "tex": "cus igitur BH $7^\\circ43'$ circiter continet. Itaque",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L030",
          "source_line_no": 30,
          "tex": "manifestum est punctum T apogei in excentrico,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L031",
          "source_line_no": 31,
          "tex": "a puncto solstitii aestivi versus partem anterio-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L032",
          "source_line_no": 32,
          "tex": "rem signorum $7^\\circ43'$ distare, scilicet $82^\\circ17'$ ab",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L033",
          "source_line_no": 33,
          "tex": "initio Arietis esse. Hoc invenire volebamus. Ob-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L034",
          "source_line_no": 34,
          "tex": "servatio iuxta quam hunc calculum fecimus,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L035",
          "source_line_no": 35,
          "tex": "anno 1194 aerae Dhū ’l-qarnayn (4) fuit, quo",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L036",
          "source_line_no": 36,
          "tex": "iter Solis ab initio Arietis ad initium Cancri et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L037",
          "source_line_no": 37,
          "tex": "ad initium Librae observavimus ({\\itshape c}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L038",
          "source_line_no": 38,
          "tex": "\\Indent Restat nunc nobis ut hanc anomaliam ad",
          "semantic_anchor": "AB01-PDF0133-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0133-body-L039",
