          "tex": "\\Indent (1) {\\itshape Almag.} III, 2 (ed. Halma, t. I, p. 161).",
          "semantic_anchor": "AB01-PDF0130-N01",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0130-notes_left-L002",
          "source_line_no": null,
          "tex": "\\Indent (2) Al-Battānī coniectura; minime Ptolemaeus",
          "semantic_anchor": "AB01-PDF0130-N02",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0130-notes_left-L003",
          "source_line_no": null,
          "tex": "dicit Hipparchum id Alexandriae observasse. Et re",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0130-notes_left-L004",
          "source_line_no": null,
          "tex": "vera nunc certum habetur Hipparchum Rhodi tan-",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0130-notes_left-L005",
          "source_line_no": null,
          "tex": "tum observationes suas perfecisse, quam perperam",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0130-notes_left-L006",
          "source_line_no": null,
          "tex": "sub eodem meridiano quo Alexandria iacere putabat.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0130-notes_left-L007",
          "source_line_no": null,
          "tex": "\\Indent (3) Codex perperam 563.",
          "semantic_anchor": "AB01-PDF0130-N03",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0130-notes_left-L008",
          "source_line_no": null,
          "tex": "\\Indent (4) $\\dfrac{1+1/5}{360}=\\dfrac{6/5}{360}=\\dfrac{6}{1800}=\\dfrac{1}{300}$.",
          "semantic_anchor": "AB01-PDF0130-N04",
          "source_role": "NALLINO_APPARATUS"
        }
      ]
    },
