      "lines": [
        {
          "id": "AB01-PDF0130-body-L001",
          "source_line_no": 1,
          "tex": "diei quae 365 diebus addebatur. Qua re de motu Solis non dubitavit, ita ut Solem aliam",
          "semantic_anchor": "AB01-PDF0130-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L002",
          "source_line_no": 2,
          "tex": "sphaeram habere cuius centrum a centris duarum sphaerarum differret, supponeret ({\\itshape b}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L003",
          "source_line_no": 3,
          "tex": "\\Indent Veteres plerumque haec ex observationibus aestivis, quae fiunt cum Sol per punctum",
          "semantic_anchor": "AB01-PDF0130-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L004",
          "source_line_no": 4,
          "tex": "solstitiale aestivum transit, deprehenderunt; sed non ita verae videntur ut observationes factae",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L005",
          "source_line_no": 5,
          "tex": "cum Sol per alterutrum punctum aequinoctiale transit, et praesertim per punctum aequinoctii",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L006",
          "source_line_no": 6,
          "tex": "autumni; hoc enim tempore aer clarior et purior est quam tempore aequinoctii vernalis. Et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L007",
          "source_line_no": 7,
          "tex": "quia Solis motus in declinatione, quando per punctum solstitiale transit, tardus est, at quando",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L008",
          "source_line_no": 8,
          "tex": "per puncta aequinoctialia iter facit, velocissimus, Ptolemaeus nonnisi observationibus autumnis",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L009",
          "source_line_no": 9,
          "tex": "confisus est, et iuxta eas calculos instituit. Una ex observationibus Hipparchi qua usus est et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L010",
          "source_line_no": 10,
          "tex": "de cuius veritate non dubitavit, ea est, qua, ut narrat (1), Solem per punctum aequinoctii",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L011",
          "source_line_no": 11,
          "tex": "autumni transiisse comperit anno 178 ab Alexandro mortuo, die tertia ex quinque diebus epa-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L012",
          "source_line_no": 12,
          "tex": "gomenis, hora mediae noctis cuius crastinum fuit quarta epagomenorum dies, Alexandria in",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L013",
          "source_line_no": 13,
          "tex": "urbe (2). Post hoc Ptolemaeus, 285 annis Aegyptiis transactis, iterum observavit, quam obser-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L014",
          "source_line_no": 14,
          "tex": "vationem ipse in libro suo accuratissimam fuisse dicit; et Solis transitum per punctum aequi-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L015",
          "source_line_no": 15,
          "tex": "noctii autumni comperit anno tertio Antonini regis, id est anno 463 (3) ab Alexandro mor-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L016",
          "source_line_no": 16,
          "tex": "tuo, die nona mensis Coptici Athyr, una hora circiter post Solis ortum, Alexandria in urbe.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L017",
          "source_line_no": 17,
          "tex": "Intervallum inter duas observationes illas invenit esse veraciter 285 annorum Aegyptiorum,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L018",
          "source_line_no": 18,
          "tex": "70 dierum, et $\\qfrac{1}{4}+\\qfrac{1}{20}$ [$=\\qfrac{3}{10}$] diei, pro 71 diebus $\\qfrac{1}{4}$, qui ex quartis partibus integris in iis",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L019",
          "source_line_no": 19,
          "tex": "285 annis colligi debebant. Ratio igitur huius unius diei minus $\\qfrac{1}{20}$ diei, --- quo tempus ob-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L020",
          "source_line_no": 20,
          "tex": "servationis praecessit tempus quartae partis diei 365 dies superantis, --- ad 285 annos inter",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L021",
          "source_line_no": 21,
          "tex": "duas illas observationes transactos, est ut ratio unius diei ad 300 annos; qua re tempus unius",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L022",
          "source_line_no": 22,
          "tex": "anni per has duas observationes inventum, complectitur 365 dies $\\qfrac{1}{4}$, detracto $\\qfrac{1}{300}$ diei, quod",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L023",
          "source_line_no": 23,
          "tex": "est una pars et quinta e 360 partibus (4).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L024",
          "source_line_no": 24,
          "tex": "\\Indent Narrat etiam Ptolemaeus, se observationes antiquas aestivas, quae factae sint ante Hip-",
          "semantic_anchor": "AB01-PDF0130-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L025",
          "source_line_no": 25,
          "tex": "parchum, accepisse, e quibus observationem esse tempore Apseudis, regis [\\textgreek{ἄρχων}] Athenarum,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L026",
          "source_line_no": 26,
          "tex": "factam, cum Sol per punctum solstitiale aestivum transivisset anno 108 (5) ante Alexandrum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L027",
          "source_line_no": 27,
          "tex": "mortuum, matutino XXI diei mensis Coptici Pharmouthi (6); deinde seipsum Solis transitum per",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L028",
          "source_line_no": 28,
          "tex": "punctum solstitii aestivi observasse anno 463 (7) post Alexandrum mortuum, XI die mensis",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L029",
          "source_line_no": 29,
          "tex": "Coptici Mesori, duabus horis circiter post mediam noctem cuius crastinum dies XII fuit (8).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L030",
          "source_line_no": 30,
          "tex": "Inter has duas observationes intercesserunt fere 571 anni Aegyptii, 140 dies et $\\qfrac{1}{2}+\\qfrac{1}{3}$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L031",
          "source_line_no": 31,
          "tex": "[$=\\qfrac{5}{6}$] diei, pro 142 diebus $\\qfrac{1}{2}+\\qfrac{1}{4}$ [$=\\qfrac{3}{4}$], qui ex quartis partibus in iis annis collecti",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L032",
          "source_line_no": 32,
          "tex": "essent si in annis quartae partes integrae fuissent. Invenit igitur tempus solstitii aestivi tempus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L033",
          "source_line_no": 33,
          "tex": "quartae integrae partis diei uno die et $\\qfrac{2}{3}+\\qfrac{1}{4}$ [$=\\qfrac{11}{12}$] praecessisse, quorum ratio ad 571",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L034",
          "source_line_no": 34,
          "tex": "annos memoratos est ut ratio duorum integrorum dierum ad 600 (9) annos; idque cum eo",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L035",
          "source_line_no": 35,
          "tex": "iuxta quod calculos fecit convenit, scilicet singulis 300 annis tempus observationis tempus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L036",
          "source_line_no": 36,
          "tex": "quartae partis integrae diei uno die praecedere, licet ob causam memoratam hae observationes",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0130-body-L037",
          "source_line_no": 37,
          "tex": "aestivae non adeo sint bonae ut autumnae. Manifestum est inter primam illam observationem",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
    },
    {
