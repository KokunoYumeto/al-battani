        {
          "id": "AB01-PDF0139-body-L001",
          "source_line_no": 3,
          "tex": "\\CenterLine{CAPUT XXX.}",
          "semantic_anchor": "AB01-PDF0139-H01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L002",
          "source_line_no": 5,
          "tex": "\\CenterLine{De sphaeris Lunae, de inaequalitate eius motus, de accretione et demi-}",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L003",
          "source_line_no": 6,
          "tex": "\\CenterLine{nutione eius luminis, de causis eclipsium, atque de distantiis geo-}",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L004",
          "source_line_no": 7,
          "tex": "\\CenterLine{centricis, diametris et magnitudinibus amborum luminarium cum}",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L005",
          "source_line_no": 8,
          "tex": "\\CenterLine{Terra comparatorum.}",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L006",
          "source_line_no": 10,
          "tex": "\\Indent Dicit [auctor]: In motibus Lunae duae inaequalitates repertae sunt. Altera, per se simplex,",
          "semantic_anchor": "AB01-PDF0139-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L007",
          "source_line_no": 11,
          "tex": "temporibus syzygiarum, quae ob medium Solis et Lunae iter iuxta locum Lunae in epicyclo",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L008",
          "source_line_no": 12,
          "tex": "fiunt, apparet. Altera per elongationes Lunae a Sole deprehenditur, et primae inaequalitati ita",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L009",
          "source_line_no": 13,
          "tex": "adiungitur ut simul unam rem efficiant, sicut demonstrationibus geometricis cognoscitur.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L010",
          "source_line_no": 14,
          "tex": "\\Indent Luna quatuor sphaeras [seu circulos] habere cogitetur; quorum primus concentricus et",
          "semantic_anchor": "AB01-PDF0139-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L011",
          "source_line_no": 15,
          "tex": "similis sit eclipticae, eodemque motu sub ea absque ulla deviatione moveatur (1) --- Secundus ab",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L012",
          "source_line_no": 16,
          "tex": "eo in septentriones et meridiem versus deflectat, sed eandem magnitudinem idemque centrum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L013",
          "source_line_no": 17,
          "tex": "ac ille habeat; maxima eius declinatio in utramque plagam versus sit fere $5^\\circ$, quae est maxima",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L014",
          "source_line_no": 18,
          "tex": "distantia latitudinalis Lunae ab ecliptica. Motus huius circuli deflectentis [i. e. obliqui] quotidie",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L015",
          "source_line_no": 19,
          "tex": "sit 3 minutorum fere in partem contrariam successioni signorum; et hic est motus duorum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L016",
          "source_line_no": 20,
          "tex": "nodorum, quorum alter, a quo Luna in latitudine ad septentriones transit, {\\itshape Caput} vocatur, alter",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L017",
          "source_line_no": 21,
          "tex": "vero, a quo Luna ad meridiem transit, {\\itshape Cauda}. Hi nodi sunt loca ubi circulus deflectens cir-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L018",
          "source_line_no": 22,
          "tex": "culum pareclipticum secat. --- Intra circulum deflectentem [seu obliquum] tertius reperiatur,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L019",
          "source_line_no": 23,
          "tex": "qui excentricus sit, a deflectente pendat, eumque in puncto omnium altissimo, {\\itshape apogeo} appel-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L020",
          "source_line_no": 24,
          "tex": "lato, contingat; ipse quotidie intra circulum deflectentem versus partem contrariam successioni",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L021",
          "source_line_no": 25,
          "tex": "signorum $11^\\circ12'$ circiter (2) moveatur. --- Quartus circulus sit epicyclus Lunae, cuius cen-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L022",
          "source_line_no": 26,
          "tex": "trum in circumferentia excentrici quotidie $24^\\circ23'$ fere (3) ad successionem signorum mo-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L023",
          "source_line_no": 27,
          "tex": "veatur, ut sit initium motus a puncto apogei excentrici dato cum loco medio Solis. Centrum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L024",
          "source_line_no": 28,
          "tex": "igitur epicycli bis in mense lunari in punctum apogei incidit; altera vice tempore mediae",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L025",
          "source_line_no": 29,
          "tex": "coniunctionis, altera tempore oppositionis; Luna autem quotidie in circumferentia epicycli",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L026",
          "source_line_no": 30,
          "tex": "fere $13^\\circ4'$ (4) versus partem contrariam successioni signorum movetur, incipiens a puncto",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L027",
          "source_line_no": 31,
          "tex": "apogei quod respectu centri excentrici consideratur. Et cum centrum epicycli super circum-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L028",
          "source_line_no": 32,
          "tex": "ferentiam circuli deflectentis duobus memoratis temporibus incidat, nihil obstat quin epicycli",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L029",
          "source_line_no": 33,
          "tex": "centrum quotidie super circumferentiam deflectentis $13^\\circ14'$ fere moveatur; et hic est motus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L030",
          "source_line_no": 34,
          "tex": "Lunae in latitudine. Sed nodus eum versus partem contrariam successioni signorum minuit",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L031",
          "source_line_no": 35,
          "tex": "tribus minutis memoratis, quae sunt motus circuli deflectentis; qua re motus Lunae in lon-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L032",
          "source_line_no": 36,
          "tex": "gitudine ad successionem signorum remanet $13^\\circ11'$ fere in die. Motus in epicyclo est primus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L033",
          "source_line_no": 37,
          "tex": "quem memoravimus.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L034",
          "source_line_no": 38,
          "tex": "\\Indent Ex iis quae diximus patet motui Lunae nullam variationem ob excentricum his duobus tem-",
          "semantic_anchor": "AB01-PDF0139-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L035",
          "source_line_no": 39,
          "tex": "poribus contingere, nam in iis Luna a loco Solis medio vel huic opposito non recedit, et inae-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0139-body-L036",
          "source_line_no": 40,
          "tex": "qualitas simplex cum altera non commiscetur eo usque quo Luna a Sole non recesserit; et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
    },
    {
