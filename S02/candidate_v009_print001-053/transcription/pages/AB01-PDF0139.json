          "id": "AB01-PDF0139-notes_right-L001",
          "source_line_no": null,
          "tex": "\\Indent (3) Est duplus motus synodicus (vel relativus",
          "semantic_anchor": "AB01-PDF0139-N03",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0139-notes_right-L002",
          "source_line_no": null,
          "tex": "sive dupla elongatio.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0139-notes_right-L003",
          "source_line_no": null,
          "tex": "\\Indent (4) Est motus diurnus anomaliae, quem \\Name{Pto-}",
          "semantic_anchor": "AB01-PDF0139-N04",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0139-notes_right-L004",
          "source_line_no": null,
          "tex": "\\Name{lemaeus} IV, 3 (ed. Halma t. I, p. 223) invenit esse",
          "semantic_anchor": null,
