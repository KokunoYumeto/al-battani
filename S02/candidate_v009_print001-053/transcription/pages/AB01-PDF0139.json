          "tex": "adn. 3.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0139-notes_left-L003",
          "source_line_no": null,
          "tex": "\\Indent (2) Nam motus apogei = duplus motus syno-",
          "semantic_anchor": "AB01-PDF0139-N02",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0139-notes_left-L004",
