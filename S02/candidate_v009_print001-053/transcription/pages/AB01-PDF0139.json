          "tex": "\\Indent (1) Eum infra {\\itshape pareclipticum} voco; cfr. p. 45,",
          "semantic_anchor": "AB01-PDF0139-N01",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0139-notes_left-L002",
