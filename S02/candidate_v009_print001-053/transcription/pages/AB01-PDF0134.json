        {
          "id": "AB01-PDF0134-body-L001",
          "source_line_no": 1,
          "tex": "describamus, ut facile possit aequatio motus Solis inveniri. Ostendit Ptolemaeus (1) motus va-",
          "semantic_anchor": "AB01-PDF0134-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L002",
          "source_line_no": 2,
          "tex": "rios duobus modis effingi posse; quorum alter est ut ponatur planetam habere circulum eclip-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L003",
          "source_line_no": 3,
          "tex": "ticae concentricum, super quem alius circulus sit, cuius centrum circumferentiam primi per-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L004",
          "source_line_no": 4,
          "tex": "currat. Hic secundus circulus est circulus minor, Terram non ambiens, cuius centrum circulus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L005",
          "source_line_no": 5,
          "tex": "maior rotare facit versus partem successionis signorum iuxta quantitatem motus longitudinalis",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L006",
          "source_line_no": 6,
          "tex": "planetae versus partem in quam signa succedunt. Sidus ipsum in epicyclo, qui est circulus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L007",
          "source_line_no": 7,
          "tex": "minor, versus praecedentem aut versus subsequentem partem movetur; aut circulus minor",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L008",
          "source_line_no": 8,
          "tex": "planetam versus alterutram partem rotare facit. Hic est motus anomaliae quae ad planetam",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L009",
          "source_line_no": 9,
          "tex": "pertinet. --- Alter explicandi modus est ut ponatur sidus habere circulum concentricum ecli-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L010",
          "source_line_no": 10,
          "tex": "pticae, et alterum excentricum sed illi aequalem, qui eum duobus locis secet Planeta est in",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L011",
          "source_line_no": 11,
          "tex": "excentrico, sive hic eum movet, sive ipse in excentrico movetur. --- Utraque ratio anomaliam",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L012",
          "source_line_no": 12,
          "tex": "pariter explicat; nos a prima incipiemus.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L013",
          "source_line_no": 13,
          "tex": "\\Indent Circulum ABCD eclipticae circa centrum E describamus; sit A, initio, centrum epicycli",
          "semantic_anchor": "AB01-PDF0134-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L014",
          "source_line_no": 14,
          "tex": "HF (2). Diametrum AC usque ad H producamus, quod est punctum apogei in epicyclo; sit F",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L015",
          "source_line_no": 15,
          "tex": "locus Solis in epicyclo, et ab eo perpendicularem supra lineam AH usque ad punctum M du-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L016",
          "source_line_no": 16,
          "tex": "camus; denique lineam AF signemus, lineae AH aequalem, nam ambae sunt semidiametri",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L017",
          "source_line_no": 17,
          "tex": "epicycli. Ob ea quae in hoc ipso capite iam diximus, patet eam $2^p4'\\,\\qfrac{3}{4}$ complecti, ut semi-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L018",
          "source_line_no": 18,
          "tex": "diametrum EF epicycli in figura praecedenti. Quo cognito, motum Solis in epicyclo versus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L019",
          "source_line_no": 19,
          "tex": "partem contrariam successioni signorum observa, vel quantitatem qua epicyclus motu medio",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L020",
          "source_line_no": 20,
          "tex": "diurno Solem versus illam partem movet, iuxta rationem qua circumferentia epicycli in $360^\\circ$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L021",
          "source_line_no": 21,
          "tex": "dividitur. Motus medius Solis, qui observationibus invenitur, est motus centri epicycli versus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L022",
          "source_line_no": 22,
          "tex": "partem successionis signorum; et hic motus quoque ea ratione ponitur qua circulus ABCD",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L023",
          "source_line_no": 23,
          "tex": "$360^\\circ$ complectitur.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L024",
          "source_line_no": 24,
          "tex": "\\Indent Arcus HF, qui est arcus epicycli inter locum Solis et punctum apogei, $30^\\circ$ contineat e",
          "semantic_anchor": "AB01-PDF0134-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L025",
          "source_line_no": 25,
          "tex": "gradibus quorum epicyclus 360 continet. Lineam EF in hac figura ducamus; et in arcum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L026",
          "source_line_no": 26,
          "tex": "lineae FM, qui est variatio motus Solis eo loco, inquiramus. Linea EA, semidiametrus circuli",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L027",
          "source_line_no": 27,
          "tex": "concentrici eclipticae, 60 partes habet ex iis quarum diametrus AC 120 continet; linea igitur",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L028",
          "source_line_no": 28,
          "tex": "EH, quae centrum circuli parecliptici (3) cum apogeo epicycli coniungit, $62^p4'45''$ erit. Et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L029",
          "source_line_no": 29,
          "tex": "quia triangulum FMA est rectangulum, quadratum lineae AF erit ut summa quadratorum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0134-body-L030",
          "source_line_no": 30,
          "tex": "AM, FM; angulus autem MAF (4) notus est, ergo etiam linea FM est nota, a qua deinde co-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
