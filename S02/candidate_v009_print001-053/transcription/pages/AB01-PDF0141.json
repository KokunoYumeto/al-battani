  "sections": [
    {
      "role": "body",
      "authorship": "NALLINO_TRANSLATION",
      "lines": [
        {
          "id": "AB01-PDF0141-body-L001",
          "source_line_no": 1,
          "tex": "lunaribus, in quibus necessarie locus verus Lunae loco vero Solis in ecliptica opponitur; qua",
          "semantic_anchor": "AB01-PDF0141-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L002",
          "source_line_no": 2,
          "tex": "re elongatio inter locum Lunae iuxta eius motum medium, et gradum gradui vero Solis oppo-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L003",
          "source_line_no": 3,
          "tex": "situm, erit inaequalitas simplex motus Lunae iuxta eius locum in epicyclo. --- Nos quoque",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L004",
          "source_line_no": 4,
          "tex": "multas eclipses lunares observavimus, earum tempora et medium diligentissime investigavimus,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L005",
          "source_line_no": 5,
          "tex": "et quantitatem huius simplicis inaequalitatis ut diximus reperimus ({\\itshape b}).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L006",
          "source_line_no": 6,
          "tex": "\\Indent Maximam quantitatem alterius inaequalitatis, contingentis ob elongationem Lunae a Sole,",
          "semantic_anchor": "AB01-PDF0141-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L007",
          "source_line_no": 7,
          "tex": "fere $2^\\circ\\qfrac{2}{3}$ attingere invenerunt (1), quibus si $5^\\circ1'$ simplicis inaequalitatis addantur, $7^\\circ40'$ cir-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L008",
          "source_line_no": 8,
          "tex": "citer proveniunt. Hoc evenit cum epicycli centrum sit in P, quod ab A quantitate [dimidii]",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L009",
          "source_line_no": 9,
          "tex": "excentrici distat (2); tunc semidiametrus epicycli [a loco Solis] declivis, erit fere $8^p$, quae",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L010",
          "source_line_no": 10,
          "tex": "sunt sinus iis $7^\\circ\\qfrac{2}{3}$ respondens.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L011",
          "source_line_no": 11,
          "tex": "\\Indent Ex iis quae diximus consequitur lineam EF, ambo centra coniungentem, $10^p19'$ (3) esse;",
          "semantic_anchor": "AB01-PDF0141-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L012",
          "source_line_no": 12,
          "tex": "idque hoc modo demonstratur. Circa centrum A, apogeum excentrici, epicyclum HG descri-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L013",
          "source_line_no": 13,
          "tex": "bamus; lineam tangentem EH, et lineam AH ducamus. Quoniam Luna in linea tangente est,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L014",
          "source_line_no": 14,
          "tex": "inaequalitas simplex tota perficitur, quam $5^\\circ1'$ esse vidimus e partibus quarum quatuor an-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L015",
          "source_line_no": 15,
          "tex": "guli recti 360 continent; eius sinus igitur $5^p15'$ (4) iuxta rationem qua semidiametrus in 60",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L016",
          "source_line_no": 16,
          "tex": "partes dividitur, ut semidiametrus circuli qui in hac figura excentricum repraesentat. --- Circa",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L017",
          "source_line_no": 17,
          "tex": "centrum P, perigeum excentrici, epicyclum HG describamus, et lineam tangentem EH atque",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L018",
          "source_line_no": 18,
          "tex": "lineam PH ducamus. Quoniam Luna in puncto H, scilicet in linea tangente, est, ambae inae-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L019",
          "source_line_no": 19,
          "tex": "qualitates perficiuntur, quarum summa $7^\\circ40'$ complectitur, et sinus summae $8^p$ fere continebit,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L020",
          "source_line_no": 20,
          "tex": "iuxta rationem qua quatuor anguli recti $360^\\circ$ efficiunt, et semidiametrus, idest EA, in 60 par-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L021",
          "source_line_no": 21,
          "tex": "tes dividitur. --- Linea PH aequalis est lineae AH, quam $5^p\\qfrac{1}{4}$ esse vidimus, si $60^p$ semidia-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L022",
          "source_line_no": 22,
          "tex": "metro EA tribuantur; sed quia centrum epicycli in locum venit quo, ob proximitatem puncti E,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L023",
          "source_line_no": 23,
          "tex": "--- quod est centrum Terrae et locus veri aspectus, --- dimensio mutari debet, id quod ex",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L024",
          "source_line_no": 24,
          "tex": "observatione apparet fiet $8^p$ circiter secundum rationem qua EA $60^p$ complectitur; sed iuxta",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L025",
          "source_line_no": 25,
          "tex": "rationem qua $8^p$ in $60^p$ convertuntur, $5^p\\qfrac{1}{4}$ fient $39^p22'$. Et haec est quantitas lineae EP,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L026",
          "source_line_no": 26,
          "tex": "centrum Terrae cum perigeo excentrici coniungentis. Similiter ut $8^p$ in $5^p\\qfrac{1}{4}$ convertuntur,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L027",
          "source_line_no": 27,
          "tex": "$60^p$ fiunt $39^p22'$. Si linea EP, quam $39^p22'$ esse vidimus, lineae EA, $60^p$ complectenti, addatur,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L028",
          "source_line_no": 28,
          "tex": "summa $99^p22'$ erit diametrus tota excentrici, cuius dimidia pars $49^p41'$ attinget. [Qua re",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L029",
          "source_line_no": 29,
          "tex": "excentricitas $10^p19'$ complectitur ex partibus quarum AE $60^p$ continet] (5).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L030",
          "source_line_no": 30,
          "tex": "\\Indent Cognita semidiametro epicycli iuxta eius declivitatem (6) respectu Solis, et cognita etiam",
          "semantic_anchor": "AB01-PDF0141-P04",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L031",
          "source_line_no": 31,
          "tex": "excentricitate atque semidiametro excentrici, restat nobis ut arcum HG, in tertia (7) columna",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L032",
          "source_line_no": 32,
          "tex": "descriptum, supputemus et exponamus quanta fiat summa aequationis simplicis et alterius in",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L033",
          "source_line_no": 33,
          "tex": "locis inter duas longinquitates, eo modo qui in tabulis descriptus est in quarta et quinta (8)",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L034",
          "source_line_no": 34,
          "tex": "columna; et, quod ad quartam columnam attinet, cum hi $2^\\circ40'$ fient $60'$ quae in quinta co-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L035",
          "source_line_no": 35,
          "tex": "lumna notantur, videamus quantum ex iis coadunetur, et quae sit eius ratio ad 60 (9). Haec",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0141-body-L036",
          "source_line_no": 36,
          "tex": "omnia, ut nunc docebimus, cognoscuntur.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
    },
    {
      "role": "notes_left",
      "authorship": "NALLINO_APPARATUS",
      "lines": [
        {
          "id": "AB01-PDF0141-notes_left-L001",
          "source_line_no": null,
          "tex": "\\Indent (1) Ita {\\itshape Almag.} V, 3 (ed. Halma t. I, p. 293--206).",
          "semantic_anchor": "AB01-PDF0141-N01",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_left-L002",
          "source_line_no": null,
          "tex": "\\Indent (2) Plato: « punctum P, quod est egressi circuli",
          "semantic_anchor": "AB01-PDF0141-N02",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_left-L003",
          "source_line_no": null,
          "tex": "longitudinis propior », i. e. perigeum excentrici. Sen-",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_left-L004",
          "source_line_no": null,
          "tex": "sus cum verbis codicis optime convenit.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_left-L005",
          "source_line_no": null,
          "tex": "\\Indent (3) Plato $10^\\circ18'$; demonstratio et numeri se-",
          "semantic_anchor": "AB01-PDF0141-N03",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_left-L006",
          "source_line_no": null,
          "tex": "quentes reperiuntur in {\\itshape Almag.} V, 4 (ed. Halma, t. I,",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_left-L007",
          "source_line_no": null,
          "tex": "p. 296--297).",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_left-L008",
          "source_line_no": null,
          "tex": "\\Indent (4) Minuta in cod. $25'$.",
          "semantic_anchor": "AB01-PDF0141-N04",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_left-L009",
          "source_line_no": null,
          "tex": "\\Indent (5) Addidi, Platonem et Ptolemaeum sequens.",
          "semantic_anchor": "AB01-PDF0141-N05",
          "source_role": "NALLINO_APPARATUS"
        }
      ]
    },
    {
      "role": "notes_right",
      "authorship": "NALLINO_APPARATUS",
      "lines": [
        {
          "id": "AB01-PDF0141-notes_right-L001",
          "source_line_no": null,
          "tex": "\\Indent (6) I. e. iuxta elongationem centri epicycli a",
          "semantic_anchor": "AB01-PDF0141-N06",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_right-L002",
          "source_line_no": null,
          "tex": "Solis loco.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_right-L003",
          "source_line_no": null,
          "tex": "\\Indent (7) Si columna numerorum singulorum, vel co-",
          "semantic_anchor": "AB01-PDF0141-N07",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_right-L004",
          "source_line_no": null,
          "tex": "lumna Solis non computetur.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_right-L005",
          "source_line_no": null,
          "tex": "\\Indent (8) Quinta et sexta.",
          "semantic_anchor": "AB01-PDF0141-N08",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_right-L006",
          "source_line_no": null,
          "tex": "\\Indent (9) \\Name{Schiaparelli} duce, interpretandum vi-",
          "semantic_anchor": "AB01-PDF0141-N09",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_right-L007",
          "source_line_no": null,
          "tex": "detur: « et quoad quartam columnam, exhibetur in",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_right-L008",
          "source_line_no": null,
          "tex": "« ea pars proportionalis ad 60 sumenda de numeris",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0141-notes_right-L009",
          "source_line_no": null,
          "tex": "« qui in quinta columna notantur ».",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        }
      ]
    }
