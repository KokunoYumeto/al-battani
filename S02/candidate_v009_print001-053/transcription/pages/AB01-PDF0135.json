          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L024",
          "source_line_no": 24,
          "tex": "continebit; remanet linea KB $1^p48'2''$, qua",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
