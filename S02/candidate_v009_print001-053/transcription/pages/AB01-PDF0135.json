        {
          "id": "AB01-PDF0135-body-L001",
          "source_line_no": 1,
          "tex": "gnoscitur reliquum latus AM trianguli, quod est [cosinus] arcus FH et anguli FAH (1). Igi-",
          "semantic_anchor": "AB01-PDF0135-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L002",
          "source_line_no": 2,
          "tex": "tur est etiam linea EM nota. Cum triangulum FME rectangulum sit, eius hypotenusa EF",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L003",
          "source_line_no": 3,
          "tex": "cognoscitur, ex qua linea FM deprehenditur; arcus autem super FM est arcus anomaliae.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L004",
          "source_line_no": 4,
          "tex": "\\Indent Si, ut posuimus, arcus FH $30^\\circ$ complectitur, eius sinus erit 30 partium, e partibus qua-",
          "semantic_anchor": "AB01-PDF0135-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L005",
          "source_line_no": 5,
          "tex": "rum semidiametrus AF 60 continet; sed ea ratione qua linea AF $2^p4'45''$ complectitur, erit",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L006",
          "source_line_no": 6,
          "tex": "linea FM $1^p2'22''\\,\\qfrac{1}{2}$ (2), reliqua igitur AM $1^p48'2''$, et linea EM (3) $61^p48'2''$ (4); unde",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L007",
          "source_line_no": 7,
          "tex": "patet [lineam EF] $61^p48'35''$ circiter esse ({\\itshape d}). Sed ex partibus quarum linea EF 60 tantum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L008",
          "source_line_no": 8,
          "tex": "habet, linea FM $1^p0'33''$ (5) continebit, et arcus super eam positus $0^\\circ57'49''$ circiter; et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L009",
          "source_line_no": 9,
          "tex": "haec est quantitas anomaliae motus Solis, scilicet arcus HF. Est igitur arcus TA eclipticae",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L010",
          "source_line_no": 10,
          "tex": "$29^\\circ2'11''$, qui antea $30^\\circ$ erat; nam epicycli centrum a T ad A motum est ut Sol in epicyclo",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L011",
          "source_line_no": 11,
          "tex": "a H ad F.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L012",
          "source_line_no": 12,
          "tex": "\\Indent Nunc epicyclum GQP consideremus, cuius centrum est B; locum Solis G ponamus, sit-",
          "semantic_anchor": "AB01-PDF0135-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L013",
          "source_line_no": 13,
          "tex": "que arcus QG (6), quem Sol a puncto Q apogei percurrit, $150^\\circ$ (7); remanent igitur $30^\\circ$ arcui",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L014",
          "source_line_no": 14,
          "tex": "PG, qui a loco Solis ad punctum perigei porrigitur. Lineam EG et perpendicularem GK du-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L015",
          "source_line_no": 15,
          "tex": "camus; patet triangula BKG et GKE rectangula esse, et latera BG, BE haud ignota; nam",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L016",
          "source_line_no": 16,
          "tex": "BG est semidiametrus epicycli (8), et BE semidiametrus circuli eclipticae. Angulus et arcus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L017",
          "source_line_no": 17,
          "tex": "GP dati sunt; perpendicularis GK et reliqua linea BK notae; [ergo etiam lineae KE et EG",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L018",
          "source_line_no": 18,
          "tex": "cognoscuntur] (9). Cum arcus GP, ut posui-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L019",
          "source_line_no": 19,
          "tex": "mus, $30^\\circ$ contineat, eius sinus quoque $30^p$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L020",
          "source_line_no": 20,
          "tex": "erit; arcus autem complementaris, qui su-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L021",
          "source_line_no": 21,
          "tex": "per KB est, sinum habebit $51^p57'41''$ (10).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
