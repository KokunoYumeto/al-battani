          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L031",
          "source_line_no": 31,
          "tex": "in $360^\\circ$ dividitur. Et hic est arcus anoma-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L032",
          "source_line_no": 32,
