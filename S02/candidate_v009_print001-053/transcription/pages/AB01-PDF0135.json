          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L026",
          "source_line_no": 26,
          "tex": "$34''$ (12) continebit ({\\itshape e}). Sed ex partibus qua-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L027",
          "source_line_no": 27,
          "tex": "rum EG 60 habet, cathetus KG $1^p4'17''$ (13)",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L028",
          "source_line_no": 28,
          "tex": "complectetur, et arcus super eam positus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L029",
          "source_line_no": 29,
          "tex": "$1^\\circ1'24''$ (14), iuxta rationem qua circulus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
