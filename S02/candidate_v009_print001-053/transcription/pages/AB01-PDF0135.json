          "tex": "--- At ex partibus quarum linea BG $2^p4'\\,\\qfrac{3}{4}$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0135-body-L023",
          "source_line_no": 23,
