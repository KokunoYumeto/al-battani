      "lines": [
        {
          "id": "AB01-PDF0132-body-L001",
          "source_line_no": 3,
          "tex": "\\CenterLine{CAPUT XXVIII.}",
          "semantic_anchor": "AB01-PDF0132-H01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L002",
          "source_line_no": 5,
          "tex": "\\CenterLine{De inaequalitate motus [sive anomalia] Solis et de eo quod}",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L003",
          "source_line_no": 6,
          "tex": "\\CenterLine{ab eius apogei loco cum illa apparet (1).}",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L004",
          "source_line_no": 8,
          "tex": "\\Indent Dicit [auctor]: Dissertatione de tempore anni et de motu medio Solis absoluta, ad expli-",
          "semantic_anchor": "AB01-PDF0132-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L005",
          "source_line_no": 9,
          "tex": "candum pergamus quae et quanta sit inaequalitas in motu Solis, et qualis appareat [cum Sol",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L006",
          "source_line_no": 10,
          "tex": "motu suo medio recesserit] a loco sui apogei in ecliptica.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L007",
          "source_line_no": 11,
          "tex": "\\Indent Rationem qua Ptolemaeus in libro suo (2) usus est sequentes, nos quo modo Sol quadran-",
          "semantic_anchor": "AB01-PDF0132-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L008",
          "source_line_no": 12,
          "tex": "tes eclipticae percurrat, per plurimas diligentissimas observationes multis subsequentibus annis",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L009",
          "source_line_no": 13,
          "tex": "factas studuimus, invenimusque Solem eclipticam a puncto aequinoctii autumni ad aequinoctii",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L010",
          "source_line_no": 14,
          "tex": "vernalis 178 diebus, 14 horis $\\qfrac{1}{2}$ circiter percurrere; a puncto autem aequinoctii vernalis ad",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L011",
          "source_line_no": 15,
          "tex": "aequinoctii autumni tempus eo longius occupare, quod ex nostris diligentissimis observationibus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L012",
          "source_line_no": 16,
          "tex": "patuit 186 dierum, 14 horarum aequinoctialium et $\\qfrac{1}{4}+\\qfrac{1}{2}$ horae circiter esse. Et ex iis",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L013",
          "source_line_no": 17,
          "tex": "quae memoravimus (3) apparuit eius apogeum in hac dimidia parte haberi.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L014",
          "source_line_no": 18,
          "tex": "\\Indent Deinde observavimus et invenimus Solem spatium ab initio Arietis ad initium Cancri,",
          "semantic_anchor": "AB01-PDF0132-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L015",
          "source_line_no": 19,
          "tex": "idest inter punctum aequinoctii vernalis et punctum solstitii aestivi, 93 diebus et 14 fere horis",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L016",
          "source_line_no": 20,
          "tex": "aequinoctialibus percurrere ({\\itshape a}), quae parum ad deminutionem inclinant; unde manifestum est",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L017",
          "source_line_no": 21,
          "tex": "cursui Solis a puncto aequinoctii vernalis ad solstitii aestivi tempus longius necessarium esse",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L018",
          "source_line_no": 22,
          "tex": "quam a puncto solstitii aestivi ad aequinoctii autumni. Scimus igitur punctum apogei et cen-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L019",
          "source_line_no": 23,
          "tex": "trum excentrici, super quem punctum apogei simul ac super eclipticam incidit, ea quarta parte",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L020",
          "source_line_no": 24,
          "tex": "contineri, quae tardioris temporis est quam reliquus quadrans. Motum medium Solis in iis",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L021",
          "source_line_no": 25,
          "tex": "186 diebus, 14 horis et $\\qfrac{1}{2}+\\qfrac{1}{4}$ horae invenimus $183^\\circ56'12''$ esse, et in iis 93 diebus et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L022",
          "source_line_no": 26,
          "tex": "14 horis $92^\\circ14'10''$ fere (4).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L023",
          "source_line_no": 27,
          "tex": "\\Indent Quae cum ita sint, circulum eclipticae ABCD circa centrum E describamus. Duae dia-",
          "semantic_anchor": "AB01-PDF0132-P04",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L024",
          "source_line_no": 28,
          "tex": "metri AC, BD se invicem ad angulos rectos abscindant, sitque A punctum aequinoctii vernalis;",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L025",
          "source_line_no": 29,
          "tex": "erit B punctum solstitii aestivi, C aequinoctii autumni, D solstitii hiemalis. In quadrante AB,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L026",
          "source_line_no": 30,
          "tex": "ob ea quae supra diximus, punctum F centrum ponamus, et, intra primum circulum, circu-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L027",
          "source_line_no": 31,
          "tex": "lum KLMN sphaerae excentricae Solis describamus, cuius diametri KM, LN se invicem in",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L028",
          "source_line_no": 32,
          "tex": "centro F ad angulos rectos abscindant. Punctum lineis BD, KM commune littera S signemus;",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L029",
          "source_line_no": 33,
          "tex": "punctum quo diametrus AC circulum KLMN versus A secat, littera P; punctum quo diame-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L030",
          "source_line_no": 34,
          "tex": "trus BD circulum KLMN versus B abscindit, littera R. In arcu PK, perpendicularem a P ad",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L031",
          "source_line_no": 35,
          "tex": "punctum Q diametri KM ducamus; item perpendicularem RG, et lineam EF quae per duo",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L032",
          "source_line_no": 36,
          "tex": "centra transit, eamque usque ad punctum H eclipticae ABCD protrahamus, littera T signantes",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L033",
          "source_line_no": 37,
          "tex": "locum quo ea circulum KLMN secat.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L034",
          "source_line_no": 38,
          "tex": "\\Indent Manifestum est arcum AB esse $90^\\circ$, ut arcum KL excentrici; punctum P excentrici esse",
          "semantic_anchor": "AB01-PDF0132-P05",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0132-body-L035",
          "source_line_no": 39,
          "tex": "initium Arietis; R locum initii Cancri; denique arcum PKLRMY excentrici eam excentrici",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
    },
    {
