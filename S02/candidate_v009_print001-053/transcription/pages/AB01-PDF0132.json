          "source_line_no": null,
          "tex": "\\Indent (1) I. e. de supputanda anomalia ad singulos",
          "semantic_anchor": "AB01-PDF0132-N01",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0132-notes_left-L002",
          "source_line_no": null,
          "tex": "gradus medii motus Solis ab apogeo.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0132-notes_left-L003",
          "source_line_no": null,
          "tex": "\\Indent (2) {\\itshape Almag.} III, 4 (ed. Halma t. I, p. 184--185.",
          "semantic_anchor": "AB01-PDF0132-N02",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0132-notes_left-L004",
          "source_line_no": null,
          "tex": "\\Indent (3) Sed antea, ut me \\Name{Schiaparelli} monet,",
          "semantic_anchor": "AB01-PDF0132-N03",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0132-notes_left-L005",
          "source_line_no": null,
          "tex": "nihil de his rebus dixit. Forte aliquid excidit ubi",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0132-notes_left-L006",
          "source_line_no": null,
          "tex": "demonstrabatur apogeum reperiendum esse in parte",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0132-notes_left-L007",
          "source_line_no": null,
          "tex": "cui maius temporis intervallum respondet.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        }
      ]
    },
    {
      "role": "notes_right",
      "authorship": "NALLINO_APPARATUS",
      "lines": [
        {
          "id": "AB01-PDF0132-notes_right-L001",
          "source_line_no": null,
          "tex": "\\Indent (4) Ita etiam in calculis infra, qua re corri-",
          "semantic_anchor": "AB01-PDF0132-N04",
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0132-notes_right-L002",
          "source_line_no": null,
          "tex": "gere non audeo; e tabulis $92^\\circ14'26''$ deducuntur.",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
          "id": "AB01-PDF0132-notes_right-L003",
          "source_line_no": null,
          "tex": "Sed antea dixerat « 93 diebus et 14 horis aequino-",
          "semantic_anchor": null,
          "source_role": "NALLINO_APPARATUS"
        },
        {
