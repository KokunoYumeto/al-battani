      "lines": [
        {
          "id": "AB01-PDF0131-body-L001",
          "source_line_no": 1,
          "tex": "et observationem Hipparchi idem fere tempus intercessisse quod inter Hipparchi et Ptolemaei;",
          "semantic_anchor": "AB01-PDF0131-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L002",
          "source_line_no": 2,
          "tex": "fuit enim observatio 286 (1) annis ante Hipparchum.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L003",
          "source_line_no": 3,
          "tex": "\\Indent Nos ipsi in urbe ar-Raqqah observavimus; et una nostrarum observationum autumna-",
          "semantic_anchor": "AB01-PDF0131-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L004",
          "source_line_no": 4,
          "tex": "rum, qua confidimus et de cuius veritate, ut ex instrumentis apparuit, haud dubitamus, est",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L005",
          "source_line_no": 5,
          "tex": "observatio quae 743 annis fuit post observationem autumnam Ptolemaei iam memoratam. Ea",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L006",
          "source_line_no": 6,
          "tex": "invenimus Solem per punctum aequinoctii autumni transivisse, anno 1194 aerae Dhū ’l-qar-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L007",
          "source_line_no": 7,
          "tex": "nayn, idest 1206 post Alexandrum mortuum, ante Solis ortum diei XIX mensis Romani Aylūl (2),",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L008",
          "source_line_no": 8,
          "tex": "scilicet VIII diei mensis Coptici Pachōn, quatuor circiter horis et $\\qfrac{1}{2}+\\qfrac{1}{4}$ ({\\itshape c}). Et quia circulus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L009",
          "source_line_no": 9,
          "tex": "meridianus Alexandriae circulum meridianum urbis ar-Raqqah $\\qfrac{2}{3}$ horae aequinoctialis circiter",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L010",
          "source_line_no": 10,
          "tex": "praecedit (3), inter observationem nostram et observationem autumnam Ptolemaei 743 anni",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L011",
          "source_line_no": 11,
          "tex": "Aegyptii, 178 dies, et $\\qfrac{1}{2}+\\qfrac{1}{4}$ diei, detractis $\\qfrac{2}{5}$ horae circiter (4), intercesserunt, loco 185",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L012",
          "source_line_no": 12,
          "tex": "dierum $\\qfrac{1}{2}+\\qfrac{1}{4}$ qui debuissent in his annis colligi si quartae partes diei integrae fuissent. Si",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L013",
          "source_line_no": 13,
          "tex": "hos 7 dies et $\\qfrac{2}{5}$ horae, quibus tempus observationis tempus quartae partis diei 365 dies supe-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L014",
          "source_line_no": 14,
          "tex": "rantis praecessit, per 743 annos qui inter duas observationes illas fuerunt dividimus, invenimus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L015",
          "source_line_no": 15,
          "tex": "portionem unius anni esse $3^\\circ24'$ ex iis $360^\\circ$ qui revolutionem diei et noctis perficiunt. Quam",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L016",
          "source_line_no": 16,
          "tex": "portionem si de tempore quartae partis diei, scilicet de $90^\\circ$ detrahimus, quantitas augmenti",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L017",
          "source_line_no": 17,
          "tex": "super 365 dies integros remanet $86^\\circ36'$; est igitur verum anni tempus $365^d14'26''$ (5) fere.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L018",
          "source_line_no": 18,
          "tex": "\\Indent Si $360^\\circ$ circumferentiae caelestis sphaerae per tempus anni nuper inventum dividimus,",
          "semantic_anchor": "AB01-PDF0131-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L019",
          "source_line_no": 19,
          "tex": "motum medium Solis in nychthemero reperimus $0^\\circ59'8''20'''46^{\\mathrm{IV}}56^{\\mathrm{V}}14^{\\mathrm{VI}}$ esse, motum au-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L020",
          "source_line_no": 20,
          "tex": "tem in 30 diebus, qui mensem Aegyptium efficiunt, $29^\\circ34'10''23'''28^{\\mathrm{IV}}6^{\\mathrm{V}}47^{\\mathrm{VI}}$, et in 365",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L021",
          "source_line_no": 21,
          "tex": "diebus anni Aegyptii $359^\\circ45'46''25'''32^{\\mathrm{IV}}2^{\\mathrm{V}}31^{\\mathrm{VI}}$ (6) circiter ({\\itshape d}). Hos motus multiplicavimus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L022",
          "source_line_no": 22,
          "tex": "et in tabulis ad annos collectos et singulos, et ad menses, dies, horas, iuxta aeram Arabum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L023",
          "source_line_no": 23,
          "tex": "aeramque Romanorum descripsimus (7), ut facile quocumque harum aerarum tempore locus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L024",
          "source_line_no": 24,
          "tex": "Solis, secundum eius motum medium qui {\\itshape medium Solis} appellatur, inveniri possit. Tempus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L025",
          "source_line_no": 25,
          "tex": "anni a nobis inventum patet $2^\\circ\\qfrac{1}{5}$ minus esse quam tempus a Ptolemaeo memorato (8); qua",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L026",
          "source_line_no": 26,
          "tex": "re motus Solis, iuxta calculum nostrum, motum a Ptolemaeo inventum in die $0^\\circ0'0''3'''$",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0131-body-L027",
          "source_line_no": 27,
          "tex": "$33^{\\mathrm{IV}}43^{\\mathrm{V}}43^{\\mathrm{VI}}$ (9) superat, et in anno Aegyptio, Deo volente, $0^\\circ0'21''40'''10^{\\mathrm{IV}}53^{\\mathrm{V}}56^{\\mathrm{VI}}$ fere (10).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
    },
