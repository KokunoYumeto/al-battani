        {
          "id": "AB01-PDF0140-body-L001",
          "source_line_no": 1,
          "tex": "\\raisebox{-0.15pt}{\\includegraphics[height=6.1pt]{AB01-PDF0140-G01.png}} his distantiis ei altera tantum inaequalitas additur, quae ab excentrico iuxta Lunae a Sole",
          "semantic_anchor": "AB01-PDF0140-P01",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L002",
          "source_line_no": 2,
          "tex": "elongationem oritur.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L003",
          "source_line_no": 3,
          "tex": "\\Indent Haec est imago quatuor sphaerarum Lunae, ad demonstrationem geometricam inserviens.",
          "semantic_anchor": "AB01-PDF0140-P02",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L004",
          "source_line_no": 4,
          "tex": "\\Indent Dicit [auctor]: Circa centrum E sit",
          "semantic_anchor": "AB01-PDF0140-P03",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L005",
          "source_line_no": 5,
          "tex": "circulus pareclipticus (1) ABCD, qui eodem",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L006",
          "source_line_no": 6,
          "tex": "tempore sit etiam circulus deflectens [i. e.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L007",
          "source_line_no": 7,
          "tex": "obliquus]; similiter sphaerae continget quae",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L008",
          "source_line_no": 8,
          "tex": "circa eius polos revolvitur. Diametrum AS",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L009",
          "source_line_no": 9,
          "tex": "ducamus, in cuius puncto F sit centrum ex-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L010",
          "source_line_no": 10,
          "tex": "centrici AMP, radio FA descripti. Arcus AM",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L011",
          "source_line_no": 11,
          "tex": "sit motus epicycli a puncto A, apogeo et",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L012",
          "source_line_no": 12,
          "tex": "loco Solis, usque ad M, quod centrum epi-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L013",
          "source_line_no": 13,
          "tex": "cycli GHRK ponamus. [Punctum F′ in dia-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L014",
          "source_line_no": 14,
          "tex": "metro ita signetur ut sit EF′ = EF]. Li-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L015",
          "source_line_no": 15,
          "tex": "neas EMG, F′MH (2) ducamus; erit G (3)",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L016",
          "source_line_no": 16,
          "tex": "locus apogei in epicyclo, ut centro E Ter-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L017",
          "source_line_no": 17,
          "tex": "rae et eclipticae apparet; H (4) locus veri",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L018",
          "source_line_no": 18,
          "tex": "apogei qui ex puncto F′ (5) conspicitur. Pa-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L019",
          "source_line_no": 19,
          "tex": "tet arcum HG esse differentiam [i. e. ae-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L020",
          "source_line_no": 20,
          "tex": "quationem] motus anomalistici Lunae in",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L021",
          "source_line_no": 21,
          "tex": "in epicyclo, quae in tertia columna tabularum aequationis Lunae (6) describitur. In epicyclo",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L022",
          "source_line_no": 22,
          "tex": "Luna a G ad H, postea ad R moveatur, denique ad K perveniat. Lineam [E]KN, epicyclum",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L023",
          "source_line_no": 23,
          "tex": "tangentem, ducamus; item MK [perpendicularem], quae erit semidiametrus epicycli [a Sole]",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L024",
          "source_line_no": 24,
          "tex": "declivis quantitate qua centrum epicycli a puncto A excentrici deflectit. Quoniam Luna est",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L025",
          "source_line_no": 25,
          "tex": "in linea epicyclum tangente, haec semidiametrus epicycli [vel angulus MEK ab eadem sub-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L026",
          "source_line_no": 26,
          "tex": "tensus] est summa inaequalitatis simplicis et alterius inaequalitatis, quae iuxta elongationem",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L027",
          "source_line_no": 27,
          "tex": "Lunae a puncto A Solis determinatur ({\\itshape a}). --- Ut ex hac figura patet, Luna stante in prima",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L028",
          "source_line_no": 28,
          "tex": "medietate GHR epicycli, locus verus Lunae in ecliptica, qui a centro E videtur, minor est",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L029",
          "source_line_no": 29,
          "tex": "loco medio eius in longitudine, qui est centrum epicycli; aequatio igitur de medio motu",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L030",
          "source_line_no": 30,
          "tex": "Lunae demitur, si anomalia minor quam $180^\\circ$ est. Cum autem Luna in altera medietate RKG",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L031",
          "source_line_no": 31,
          "tex": "sit, eius locus verus locum medium in ecliptica superat; qua re, anomalia $180^\\circ$ excedente,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L032",
          "source_line_no": 32,
          "tex": "aequatio, si Deus vult, motui medio Lunae est addenda.",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L033",
          "source_line_no": 33,
          "tex": "\\Indent Aequatio simplex, quae temporibus syzygiarum apparet et in hoc nostro libro in secunda",
          "semantic_anchor": "AB01-PDF0140-P04",
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L034",
          "source_line_no": 34,
          "tex": "columna tabularum aequationis (7) describitur, iam diximus quo modo numeris supputetur,",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L035",
          "source_line_no": 35,
          "tex": "eadem via quam secuti sumus in calculanda et in tabulis describenda aequatione Solis (8).",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L036",
          "source_line_no": 36,
          "tex": "Maxima quantitas, quam haec simplex inaequalitas Lunae attingere potest, est $5^\\circ1'$ (9), cuius",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L037",
          "source_line_no": 37,
          "tex": "sinus, qui tunc erit semidiametrus epicycli, $5^p\\qfrac{1}{4}$ fere complectitur; talis enim est ratio 60 par-",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        },
        {
          "id": "AB01-PDF0140-body-L038",
          "source_line_no": 38,
          "tex": "tium semidiametrum efficientium ad $5^p\\qfrac{1}{4}$. Id Ptolemaeus (10) declaravit et probavit eclipsibus",
          "semantic_anchor": null,
          "source_role": "NALLINO_TRANSLATION"
        }
      ]
    },
