    },
    {
     "id": "AB01-PDF0693-body-L005",
     "source_line_no": 5,
     "tex": "\\mbox{}\\rlap{\\hspace*{50.30mm}$IE':E'F=\\sin IFE':\\sin FIE'$}",
     "transcription": "$IE':E'F=\\sin IFE':\\sin FIE'$",
     "semantic_anchor": null,
     "source_role": "NALLINO_ADNOTATIONES"
    },
    {
     "id": "AB01-PDF0693-body-L006",
     "source_line_no": 6,
     "tex": "\\mbox{}\\rlap{\\hspace*{0.00mm}vel}\\rlap{\\hspace*{43.80mm}$IE':\\;e\\;=\\sin\\,(180^\\circ-m):\\sin\\left(\\dfrac{m}{2}\\right)$\\,,}",
     "transcription": "vel $IE':\\;e\\;=\\sin\\,(180^\\circ-m):\\sin\\left(\\dfrac{m}{2}\\right)$\\,,",
