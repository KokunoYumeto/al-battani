     "source_role": "NALLINO_ADNOTATIONES"
    },
    {
     "id": "AB01-PDF0693-body-L008",
     "source_line_no": 8,
     "tex": "\\mbox{}\\rlap{\\hspace*{0.00mm}et quia}\\rlap{\\hspace*{41.50mm}$\\sin m=\\sin 2\\left(\\dfrac{m}{2}\\right)=2\\sin\\left(\\dfrac{m}{2}\\right)\\cos\\left(\\dfrac{m}{2}\\right)$\\,,}",
     "transcription": "et quia $\\sin m=\\sin 2\\left(\\dfrac{m}{2}\\right)=2\\sin\\left(\\dfrac{m}{2}\\right)\\cos\\left(\\dfrac{m}{2}\\right)$\\,,",
