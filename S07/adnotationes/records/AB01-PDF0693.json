     "source_role": "NALLINO_ADNOTATIONES"
    },
    {
     "id": "AB01-PDF0693-body-L007",
     "source_line_no": 7,
     "tex": "\\mbox{}\\rlap{\\hspace*{0.00mm}unde}\\rlap{\\hspace*{47.60mm}$IE'=\\dfrac{e\\sin(180^\\circ-m)}{\\sin\\left(\\dfrac{m}{2}\\right)}=\\dfrac{e\\sin m}{\\sin\\left(\\dfrac{m}{2}\\right)}$\\,;}",
     "transcription": "unde $IE'=\\dfrac{e\\sin(180^\\circ-m)}{\\sin\\left(\\dfrac{m}{2}\\right)}=\\dfrac{e\\sin m}{\\sin\\left(\\dfrac{m}{2}\\right)}$\\,;",
